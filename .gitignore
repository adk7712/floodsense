.venv
__pycache__/
*.pyc
.pytest_cache/
mlruns/
mlflow.db
.coverage
.DS_Store
*.parquet
data/raw/*
# The NEA rainfall store (~18 MB of Parquet, 2017 onward) is committed so the app can replay any
# date and nobody has to rebuild it. Raw CSVs, sightings and the manifest stay local.
!data/raw/rainfall/
data/raw/rainfall/*
!data/raw/rainfall/readings/
!data/raw/rainfall/readings/**
!data/raw/rainfall/stations.parquet
.playwright-mcp/
tests/screenshots/
data/reports/
.claude/
.agents/
data/processed/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Candidate models are rebuilt by select_candidates; only the champion (models/flood_model.joblib) is committed
models/candidates/*.joblib

# Secrets (e.g. FLOODSENSE_DATA_GOV_API_KEY) - never commit
.env
.env.*
!.env.example
.streamlit/secrets.toml
.streamlit/credentials.toml
.streamlit/machine_id_v4

# CI outputs (licence report and dependency audit; see docs/ROUND2_HANDOFF.md "CI checks")
licenses.json
licence_report.md
requirements-audit.txt

# Coverage / notebooks
htmlcov/
.coverage.*
.ipynb_checkpoints/
