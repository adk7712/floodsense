{
  "name": "floodsense-rainfall-poller",
  "description": "Lands recent NEA rainfall in the landing volume, runs the floodsense pipeline (triggered update, not a full refresh), then posts Telegram alerts from the newest gold step. The bot reads its token and chat id from the secrets scope 'floodsense' (telegram_bot_token, telegram_chat_id); the per-zone state file on the artifacts volume stops re-sends.",
  "tags": {
    "project": "floodsense",
    "track": "DAISI-B2",
    "role": "ingest-score"
  },
  "max_concurrent_runs": 1,
  "schedule": {
    "quartz_cron_expression": "0 0/30 * * * ?",
    "timezone_id": "Asia/Singapore",
    "pause_status": "PAUSED"
  },
  "environments": [
    {
      "environment_key": "poller",
      "spec": {
        "client": "2",
        "dependencies": [
          "/Volumes/workspace/floodsense/artifacts/wheels/floodsense-0.1.0-py3-none-any.whl"
        ]
      }
    }
  ],
  "tasks": [
    {
      "task_key": "poll_rainfall",
      "environment_key": "poller",
      "spark_python_task": {
        "python_file": "/Workspace/Users/<your-login>/floodsense/poll_rainfall.py",
        "parameters": [
          "--lookback-minutes",
          "40"
        ]
      },
      "timeout_seconds": 900
    },
    {
      "task_key": "refresh_pipeline",
      "depends_on": [
        {
          "task_key": "poll_rainfall"
        }
      ],
      "pipeline_task": {
        "pipeline_id": "c32feb3d-5e5f-4c78-8219-e3acf131e804",
        "full_refresh": false
      },
      "timeout_seconds": 1800
    },
    {
      "task_key": "telegram_alerts",
      "depends_on": [
        {
          "task_key": "refresh_pipeline"
        }
      ],
      "environment_key": "poller",
      "spark_python_task": {
        "python_file": "/Workspace/Users/<your-login>/floodsense/telegram_bot.py",
        "parameters": [
          "--warehouse-id",
          "<warehouse-id>",
          "live",
          "--once",
          "--state-file",
          "/Volumes/workspace/floodsense/artifacts/telegram_state.json",
          "--subscriptions-file",
          "/Volumes/workspace/floodsense/artifacts/telegram_subscriptions.json"
        ]
      },
      "timeout_seconds": 240
    }
  ]
}
